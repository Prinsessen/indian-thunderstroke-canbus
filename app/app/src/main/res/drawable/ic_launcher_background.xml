<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon background. A dark face lit slightly from the centre, the same
  ground the cluster's dials sit on, so the icon belongs to the app rather than
  merely pointing at it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="62"
                android:startColor="#1A2029"
                android:endColor="#080A0E" />
        </aapt:attr>
    </path>
</vector>
