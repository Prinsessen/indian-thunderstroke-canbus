<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line"
        android:layout_marginTop="6dp" />

    <TextView
        android:id="@+id/odo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="10dp"
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:textColor="@color/ink" />

    <TextView
        android:id="@+id/service"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="3dp"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:textColor="@color/muted" />

    <TextView
        android:id="@+id/ridestats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="4dp"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:textColor="@color/accent" />

    <TextView
        android:id="@+id/records"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="3dp"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:textColor="@color/muted" />

    <TextView
        android:id="@+id/dtc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="4dp"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:textColor="@color/muted" />
    <!-- The maker's plate used to sit here and does not any more. It shows on
         the splash for four or five seconds at every start, and it appears again
         at the foot of the settings page, where tapping it now opens About. Three
         times on one screen's worth of app was two too many, and on this page it
         was also taking room the gauges needed. -->
</LinearLayout>
